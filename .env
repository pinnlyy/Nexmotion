# Nexmotion environment variables
# Server-side only. Never expose these in client code.

# Public API base for optional external preset registry (adapter ready, plug in any service)
NEX_PRESET_API_URL=
NEX_PRESET_API_KEY=

# YouTube Data API (optional; keyword/video search via YouTube)
YOUTUBE_API_KEY=

# CORS-safe user agent used by the scraper
NEX_USER_AGENT=Nexmotion/1.0 (+https://nexmotion.app)
